# SkillSupport Server Configuration
PORT=5001
JWT_SECRET=replace_with_a_secure_jwt_secret_for_production_use

# Google Gemini AI Integration
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# SQLite Database path (optional, defaults to server/database/skillsupport.sqlite)
DATABASE_PATH=./database/skillsupport.sqlite
